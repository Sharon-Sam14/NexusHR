# ==============================================================================
# NexusHR — Environment Configuration Example File
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# --- DATABASE CONFIGURATION ---
DB_URL=jdbc:postgresql://localhost:5432/nexushr
DB_USERNAME=postgres
DB_PASSWORD=123456

# --- JWT SECURITY CONFIGURATION ---
JWT_SECRET=NexusHRSuperSecretKey2024ProductionGradeJWTKey!@#$%
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- CLOUDINARY FILE STORAGE (Optional — falls back to local uploads if empty) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- SERVER CONFIGURATION ---
PORT=8081
