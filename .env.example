# ==============================================================================
# NexusHR — Environment Variables Reference
# ==============================================================================
# HOW TO USE THIS FILE:
#   Development  → Copy to .env and fill in local values (never commit .env)
#   Render       → Set each variable in your Render service's "Environment" tab
#   Vercel       → Set VITE_* variables in your Vercel project settings
# ==============================================================================
# SECURITY RULE: Never commit real credentials to source control.
#                This file contains PLACEHOLDER VALUES ONLY.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND — DATABASE (Neon PostgreSQL in production)
# ------------------------------------------------------------------------------
# Dev:  Your local PostgreSQL connection string
# Prod: Your Neon connection string (found in Neon dashboard → Connection Details)

DB_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DB_USERNAME=<your_db_username>
DB_PASSWORD=<your_db_password>

# ------------------------------------------------------------------------------
# BACKEND — JWT SECURITY
# ------------------------------------------------------------------------------
# Generate a strong secret for production:
#   Linux/Mac: openssl rand -hex 64
#   Windows:   [System.Web.Security.Membership]::GeneratePassword(64, 10)
# MINIMUM LENGTH: 32 characters. Shorter keys will cause startup failure.

JWT_SECRET=<replace_with_a_long_random_secret_minimum_32_characters>

# ------------------------------------------------------------------------------
# BACKEND — SERVER
# ------------------------------------------------------------------------------
# Render sets PORT automatically. You can leave this unset on Render.
# Locally it defaults to 8081 in application.properties.

PORT=8081

# ------------------------------------------------------------------------------
# BACKEND — SPRING PROFILE
# ------------------------------------------------------------------------------
# Set this to "prod" on Render. Leave unset locally (uses base application.properties).

SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------------------------
# BACKEND — CORS
# ------------------------------------------------------------------------------
# Your Vercel frontend URL. No trailing slash.
# Example: https://nexushr.vercel.app
# Multiple origins: https://nexushr.vercel.app,https://nexushr-preview.vercel.app

FRONTEND_URL=https://<your-app>.vercel.app

# ------------------------------------------------------------------------------
# BACKEND — CLOUDINARY (Optional)
# ------------------------------------------------------------------------------
# Leave ALL THREE blank to use local mock mode (files saved to /uploads folder).
# Set ALL THREE to enable real Cloudinary uploads.
# Free account: https://cloudinary.com/users/register_free

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# FRONTEND — Vite Environment Variables (Vercel)
# ------------------------------------------------------------------------------
# These are read by the React frontend at build time.
# Set them in your Vercel project → Settings → Environment Variables.
# They MUST start with VITE_ to be accessible in the browser.

# Your Render backend URL. No trailing slash.
# Example: https://nexushr-api.onrender.com
VITE_API_BASE_URL=https://<your-render-service>.onrender.com
